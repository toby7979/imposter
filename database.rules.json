{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "hostSecret": {
          ".read": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "clues": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            ".validate": "newData.child('round').isNumber() && newData.child('texts').hasChildren()",
            "round": {
              ".validate": "newData.isNumber()"
            },
            "texts": {
              "$c": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "votes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "scores": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "words": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          "$pid": {
            ".read": "auth != null && $pid === auth.uid"
          }
        }
      }
    },
    "tribePicker": {
      "moves": {
        ".read": true,
        "$setup": {
          ".validate": "$setup.matches(/^(drylands|lakes|pangea|continents|archipelago|waterworld)_(tiny|small|normal|large|huge|massive)$/)",
          "$tribe": {
            ".validate": "$tribe.matches(/^(xinxi|imperius|bardur|oumaji|kickoo|hoodrick|luxidoor|vengir|zebasi|aimo|quetzali|yadakk|aquarion|elyrion|polaris|cymanti)$/)",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === 1 || newData.val() === -1"
            }
          }
        }
      }
    }
  }
}
